PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/local_service_booking
JWT_SECRET=supersecret_localserve_jwt_key_2026
JWT_EXPIRES_IN=7d

# ── Gmail SMTP ────────────────────────────────────────────────────────────────
# Step 1: Enable 2-Step Verification on your Google account
#         https://myaccount.google.com/security
# Step 2: Create an App Password
#         Google Account → Security → 2-Step Verification → App Passwords
#         Choose "Mail" + "Other (Custom name: LocalServe)" → Generate
# Step 3: Paste the 16-character App Password below (no spaces)
GMAIL_USER=your_actual_gmail@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# ── OpenRouteService (map routing) ───────────────────────────────────────────
# Get a free key at https://openrouteservice.org/sign-up/
ORS_API_KEY=your_ors_api_key_here
